{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/db",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:validate": "tsx db/seed/cli.ts --validate-only",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx db/seed/cli.ts"
  },
  "dependencies": {
    "@dnd-kit/accessibility": "3.1.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "0.45.2",
    "next": "15.5.25",
    "postgres": "3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "description": "A four-year academic and extracurricular planner that reasons about the consequences of course decisions."
}
