# Compass environment variables.
#
# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API      for the URL and keys
#   Project Settings -> Database for the connection string
#
# .env.local is gitignored. Never commit real values.

# --- Public: inlined into the browser bundle by Next ---------------------
# Safe to expose. The anon key grants nothing on its own; what a request may
# actually do is decided by the user's token and the row-level security
# policies in db/migrations/0001_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only: never prefix these NEXT_PUBLIC_ ------------------------
# The service role bypasses row-level security entirely. It belongs to the
# seed script and nothing else. If this ever reaches a browser, every
# student's plan is readable by every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by Drizzle for migrations, seeding, and
# reading the public catalog. Also privileged.
DATABASE_URL=

# --- Tests ---------------------------------------------------------------
# The live row-level-security proof (tests/db/rls.test.ts) runs only when this
# is set, and is deliberately a separate variable from DATABASE_URL: the test
# creates and deletes users, so pointing it at a real database should be a
# deliberate act. Use a scratch database or a dev Supabase project.
TEST_DATABASE_URL=
