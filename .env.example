# Postgres connection string for production. When unset, Compass runs an
# embedded Postgres (PGlite) persisted to .data/pglite -- fine for local work,
# not for a deployed app.
DATABASE_URL=

# Gemini API key for Compass AI. Server-side only; never prefix with NEXT_PUBLIC_.
# Without it, Compass AI reports itself offline and every deterministic feature
# (planning, validation, explanations, what-if) keeps working.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-3.5-flash
